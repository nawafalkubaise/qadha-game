# انسخ إلى ملف .env في نفس مجلد docker-compose (اختياري)
# ثم أضف في docker-compose.yaml تحت qadha:
#   env_file: .env

NODE_ENV=production
QADHA_SERVER_PORT=3001
QADHA_TRUST_PROXY=1

# مفتاح إضافة أسئلة عبر API (اتركه فارغاً لتعطيل المسار)
# QADHA_ADMIN_KEY=ضع_مفتاحاً_طويلاً_عشوائياً

# فصل واجهة عن API (نادر مع Docker الموحد)
# QADHA_CORS_ORIGINS=https://واجهتك.example
