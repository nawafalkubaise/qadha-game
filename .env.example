# انسخ هذا الملف إلى .env.local واملأ القيم (لا ترفع .env.local إلى Git)
ANTHROPIC_API_KEY=

# سين جيم (اختياري): توكن الجلسة من seenjeemkw.com — يعمل مع npm run dev فقط
# 1) سجّل دخول على الموقع
# 2) F12 → Network → طلب إلى api.seenjeemkw.com
# 3) Headers → Authorization: Bearer eyJ...  ← انسخ الجزء بعد Bearer فقط (بدون كلمة Bearer)
# 4) أعد تشغيل npm run dev بعد الحفظ
SEENJEEM_TOKEN=
