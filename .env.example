# نشر Docker للعامة: دليل كامل DEPLOY.md | فحص: npm run share:check | قالب أسرار: .env.share.example
#
# انسخ هذا الملف إلى .env.local واملأ القيم (لا ترفع .env.local إلى Git)
ANTHROPIC_API_KEY=

# خادم المحتوى/الغرف (اختياري — للتطوير عادة يُشغَّل عبر npm run dev مع server/index.mjs)
# ضع نفس القيمة في بيئة تشغيل الخادم (PowerShell: $env:QADHA_ADMIN_KEY="...")
# QADHA_ADMIN_KEY=
# QADHA_SERVER_PORT=3001
#
# نفق عام إن لم يفتح trycloudflare: جرّب `npm run tunnel:lt` أو `tunnel:lt:prod` أو ngrok.
# سكربتات cloudflared تستخدم --protocol http2 لتفادي حظر QUIC.
#
# إنتاج — واجهة + API + WebSocket من منفذ واحد: npm run start:prod ثم افتح http://127.0.0.1:3001
# مجلد البناء (افتراضي: مجلد dist بجانب server/)
# QADHA_DIST_DIR=
#
# خلف nginx / Cloudflare / سحابة: للحصول على IP حقيقي وللـ cookies أحياناً
# QADHA_TRUST_PROXY=1
#
# واجهة على نطاق مختلف عن الـ API: أضف أصل الواجهة الكامل (مع https)
# QADHA_CORS_ORIGINS=https://game.example.com
#
# إن غيّرت منفذ الخادم وواجهة التطوير على localhost، ضبط المنفذ هنا أيضاً:
# VITE_QADHA_SERVER_PORT=3001
# للإنتاج إن كانت الواجهة منفصلة (CDN): وجّهها لعنوان الـ API (بدون شرطة أخيرة)
# VITE_QADHA_API=https://api.example.com
